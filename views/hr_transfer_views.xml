<?xml version="1.0" encoding="utf-8"?>
<odoo>
    <!-- Transfer Form View -->
    <record id="view_hr_transfer_form" model="ir.ui.view">
        <field name="name">hr.transfer.form</field>
        <field name="model">hr.transfer</field>
        <field name="arch" type="xml">
            <form string="Employee Transfer">
                <header>
                    <button name="action_submit" string="Submit" type="object" class="btn-primary" invisible="state != 'draft'"/>
                    <button name="action_current_manager_approve" string="Current Manager Approve" type="object" class="btn-primary" invisible="state != 'submitted'"/>
                    <button name="action_receiving_manager_approve" string="Receiving Manager Accept" type="object" class="btn-primary" invisible="state != 'current_approved'"/>
                    <button name="action_approve" string="HR / GM Approve" type="object" class="btn-success" invisible="state != 'receiving_approved'" groups="hr.group_hr_user"/>
                    <button name="action_apply_transfer" string="Execute Transfer" type="object" class="btn-success" invisible="state != 'approved'" groups="hr.group_hr_user"/>
                    <button name="action_reject" string="Reject" type="object" class="btn-danger" invisible="state not in ('submitted', 'current_approved', 'receiving_approved')"/>
                    <button name="action_reset_draft" string="Reset to Draft" type="object" class="btn-secondary" invisible="state not in ('rejected', 'draft')"/>
                    <field name="state" widget="statusbar" statusbar_visible="draft,submitted,current_approved,receiving_approved,approved,done"/>
                </header>
                <sheet>
                    <div class="oe_title">
                        <label for="name" string="Transfer Reference"/>
                        <h1><field name="name"/></h1>
                    </div>
                    <group>
                        <group string="Employee &amp; Timing">
                            <field name="employee_id"/>
                            <field name="company_id" groups="base.group_multi_company"/>
                            <field name="transfer_type"/>
                            <field name="effective_date"/>
                        </group>
                        <group string="Approval &amp; Audit">
                            <field name="approved_by_id"/>
                            <field name="approval_date"/>
                        </group>
                    </group>
                    <group>
                        <group string="Current Organization (Source)">
                            <field name="current_department_id"/>
                            <field name="current_job_id"/>
                            <field name="current_manager_id"/>
                            <field name="current_address_id"/>
                        </group>
                        <group string="New Organization (Destination)">
                            <field name="new_department_id" required="transfer_type == 'department'"/>
                            <field name="new_job_id"/>
                            <field name="new_manager_id" required="transfer_type == 'manager'"/>
                            <field name="new_address_id" required="transfer_type == 'location'"/>
                        </group>
                    </group>
                    <group string="Justification">
                        <field name="reason" placeholder="Explain the operational reason or employee request for transfer..."/>
                    </group>
                </sheet>
                <chatter/>
            </form>
        </field>
    </record>

    <!-- Transfer List View -->
    <record id="view_hr_transfer_tree" model="ir.ui.view">
        <field name="name">hr.transfer.list</field>
        <field name="model">hr.transfer</field>
        <field name="arch" type="xml">
            <list string="Employee Transfers">
                <field name="name"/>
                <field name="employee_id"/>
                <field name="transfer_type"/>
                <field name="current_department_id"/>
                <field name="new_department_id"/>
                <field name="effective_date"/>
                <field name="state" widget="badge"
                       decoration-info="state in ('draft', 'submitted')"
                       decoration-warning="state in ('current_approved', 'receiving_approved', 'approved')"
                       decoration-success="state == 'done'"
                       decoration-danger="state == 'rejected'"/>
            </list>
        </field>
    </record>

    <record id="action_hr_transfer" model="ir.actions.act_window">
        <field name="name">Employee Transfers</field>
        <field name="res_model">hr.transfer</field>
        <field name="view_mode">list,form</field>
    </record>
</odoo>
