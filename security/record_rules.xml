<?xml version="1.0" encoding="utf-8"?>
<odoo>
    <data noupdate="1">
        <!-- Multi-Company Rule: Transfer -->
        <record id="rule_hr_transfer_multi_company" model="ir.rule">
            <field name="name">Transfer: Multi-Company</field>
            <field name="model_id" ref="model_hr_transfer"/>
            <field name="domain_force">[('company_id', 'in', company_ids)]</field>
        </record>

        <!-- Employee Self-Service / Manager Hierarchy Rule: Transfer -->
        <record id="rule_hr_transfer_user" model="ir.rule">
            <field name="name">Transfer: Employee and Line Manager</field>
            <field name="model_id" ref="model_hr_transfer"/>
            <field name="domain_force">['|', '|', ('employee_id.user_id', '=', user.id), ('current_manager_id.user_id', '=', user.id), ('new_manager_id.user_id', '=', user.id)]</field>
            <field name="groups" eval="[(4, ref('base.group_user'))]"/>
        </record>

        <!-- HR Manager: Full Access for Transfer -->
        <record id="rule_hr_transfer_hr_manager" model="ir.rule">
            <field name="name">Transfer: HR Full Access</field>
            <field name="model_id" ref="model_hr_transfer"/>
            <field name="domain_force">[(1, '=', 1)]</field>
            <field name="groups" eval="[(4, ref('hr.group_hr_user'))]"/>
        </record>

        <!-- Multi-Company Rule: Promotion -->
        <record id="rule_hr_promotion_multi_company" model="ir.rule">
            <field name="name">Promotion: Multi-Company</field>
            <field name="model_id" ref="model_hr_promotion"/>
            <field name="domain_force">[('company_id', 'in', company_ids)]</field>
        </record>

        <!-- Promotion: Employee and Direct Manager -->
        <record id="rule_hr_promotion_user" model="ir.rule">
            <field name="name">Promotion: Employee and Line Manager</field>
            <field name="model_id" ref="model_hr_promotion"/>
            <field name="domain_force">['|', ('employee_id.user_id', '=', user.id), ('employee_id.parent_id.user_id', '=', user.id)]</field>
            <field name="groups" eval="[(4, ref('base.group_user'))]"/>
        </record>

        <!-- Promotion: HR Full Access -->
        <record id="rule_hr_promotion_hr_manager" model="ir.rule">
            <field name="name">Promotion: HR Full Access</field>
            <field name="model_id" ref="model_hr_promotion"/>
            <field name="domain_force">[(1, '=', 1)]</field>
            <field name="groups" eval="[(4, ref('hr.group_hr_user'))]"/>
        </record>

        <!-- Multi-Company Rule: Disciplinary -->
        <record id="rule_hr_disciplinary_multi_company" model="ir.rule">
            <field name="name">Disciplinary: Multi-Company</field>
            <field name="model_id" ref="model_hr_disciplinary_action"/>
            <field name="domain_force">[('company_id', 'in', company_ids)]</field>
        </record>

        <!-- Disciplinary: Employee and Line Manager -->
        <record id="rule_hr_disciplinary_user" model="ir.rule">
            <field name="name">Disciplinary: Employee and Line Manager</field>
            <field name="model_id" ref="model_hr_disciplinary_action"/>
            <field name="domain_force">['|', ('employee_id.user_id', '=', user.id), ('manager_id.user_id', '=', user.id)]</field>
            <field name="groups" eval="[(4, ref('base.group_user'))]"/>
        </record>

        <!-- Disciplinary: HR Full Access -->
        <record id="rule_hr_disciplinary_hr_manager" model="ir.rule">
            <field name="name">Disciplinary: HR Full Access</field>
            <field name="model_id" ref="model_hr_disciplinary_action"/>
            <field name="domain_force">[(1, '=', 1)]</field>
            <field name="groups" eval="[(4, ref('hr.group_hr_user'))]"/>
        </record>
    </data>
</odoo>
